99001330137253, -0.12275343388319016, -0.11044764518737793, -0.21734219789505005, 0.2591179609298706, 0.0671088844537735, 0.00928990077227354, 0.12398110330104828, 0.1665530800819397, 0.12447626888751984, 0.11305344104766846, 0.06583432853221893, 0.08674629777669907, -0.00853341817855835, 0.20387332141399384, 0.22468003630638123, -0.06623716652393341, -0.14520499110221863, 0.13482093811035156, -0.011998923495411873, 0.0613214373588562, -0.028144726529717445, 0.10370887815952301, 0.03482353314757347, 0.08234316110610962, 0.05032810941338539], "n_turns": 17}], "transcript": {"timestamp_resolution": "word", "segments": [{"start": 0.433, "end": 7.775, "text": " شما گفتم که تازه از ایران آمدیم؟ ما برادر یک ماه مشه از ایران آمدیم خب؟ ما 25 سال ایران بودیم.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 8.276, "end": 9.736, "text": "این بچه ایم ایران دنیا آمده هست.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 9.756, "end": 10.976, "text": "این بچه ایم ایران متولد شده.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 10.996, "end": 11.697, "text": "این بچه ایم هست.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 11.717, "end": 12.797, "text": "این بچه ایم هست.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 12.837, "end": 16.038, "text": "ما یک ماه مشه که از ایران رده مرسیدیم آمدیم.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 16.078, "end": 19.399, "text": "چند سال بودیم در ایران؟ ما 25 سال هست که ایران هستیم.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 19.459, "end": 20.459, "text": "25 سال ایران بودیم.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 20.499, "end": 23.2, "text": "بازم ما رو از خانه ما کشید.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 23.22, "end": 24.101, "text": "کل زندگی ما در", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 28.682, "end": 31.885, "text": " از کجا اولایت هستیم؟ از اولایت تخوار هستیم، از لسوالیش که میشه هستیم.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 32.545, "end": 35.648, "text": "دوباره میخوام، دوباره حالی با زن و بچه آمدیم، دیگه پس ایران برام.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 35.668, "end": 37.61, "text": "دوباره میخوام برام؟ دوباره میخوام برام.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 37.81, "end": 41.153, "text": "یک ماست اینجا، ما نه کار پیدا کردیم، نه دیگه کردیم.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 41.833, "end": 43.715, "text": "هیچ کسی قدی کسی کمک نمیکنه.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 43.955, "end": 48.859, "text": "فهمیدی؟ دوباره مجبور شدیم با این زن و بچه، با اینا، میخوام دوباره ایران برام.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 48.999, "end": 49.139, "text": "ام", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 56.305, "end": 57.606, "text": " در تخخار یک ماه بودیم.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 58.007, "end": 59.488, "text": "یک ماه از ایران آمدیم.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 59.528, "end": 60.749, "text": "یک ماه از ایران آمدیم.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 60.789, "end": 62.531, "text": "یک ماه از ایران آمدیم.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 62.551, "end": 67.056, "text": "در ایران چی کار میکنی؟ در ایران ما کارهای روزموزی میکنیم.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 67.416, "end": 69.478, "text": "این بچه هم در باشباک کار میکنه.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 69.538, "end": 71.46, "text": "چهار پنیز کمربند هم گرفتگی هست.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 71.58, "end": 73.082, "text": "در اونجا؟ در اونجا در ایران.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 73.602, "end": 76.645, "text": "دیگه اینجا که آمدیم برادر کسی سنه کسی نمیبونه.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 76.665, "end": 79.568, "text": "این حال گفت در کجا هست؟ شبا 25 سال در ای", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 80.789, "end": 84.495, "text": " چی رو آوردن از ایران؟ هیچ چیز رو نآوردن؟ هیچ چیز نآوردن.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 84.535, "end": 86.117, "text": "این فکر بود که خلاست دیگه.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 86.357, "end": 89.522, "text": "این حاله یک ماه شده از شما.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 89.922, "end": 91.545, "text": "یک چند وقت در بر میگه.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 91.585, "end": 93.027, "text": "اون معلوم دارست که سخت است.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 93.047, "end": 94.949, "text": "شما از صفر مجبور است که شروع کنین.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 95.13, "end": 98.234, "text": "خب عیسی فرمانی... روزی که آمدین از ایران.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 98.314, "end": 100.497, "text": "امارت اسلامی خب پیسه اون کرایتون رو داد.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 100.618, "end": 102.28, "text": "در ما دو هزاری پس این مرز دادن.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 102.42, "end": 103.762, "text": "تا تخوارکی برده تانی؟", "speaker_id": "SPEAKER_01", "flags": []}], "words": [{"start": 0.433, "end": 2.234, "word": "شما", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 2.274, "end": 2.514, "word": "گفتم", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 2.574, "end": 2.654, "word": "که", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 2.694, "end": 2.894, "word": "تازه", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 2.934, "end": 3.054, "word": "از", "segment_idx": 0, "speaker_id": "SPEAKER_01"}, {"start": 3.074, "end": 3.294, "word": "ایران", "segment_idx": 0, "speaker_id": "SPEAKER_01"}, {"start": 3.394, "end": 3.654, "word": "آمدیم؟", "segment_idx": 0, "speaker_id": "SPEAKER_01"}, {"start": 3.774, "end": 3.894, "word": "ما", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 3.914, "end": 4.294, "word": "برادر", "segment_idx": 0, "speaker_id": "SPE