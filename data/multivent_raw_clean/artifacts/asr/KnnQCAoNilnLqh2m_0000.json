"segments": [{"start": 2.671, "end": 4.832, "text": " Terör örgütü PKK'nın nefesini kestik.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 5.252, "end": 10.153, "text": "Son kalanı da burada Kürdüyle, Arabıyla, Türkmen askeriyle tamamen keseceğiz.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 10.593, "end": 12.833, "text": "Kişlin bölgesini kontrol altına alacağız.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 12.893, "end": 15.334, "text": "Kardeşliğin bozulmasına izin vermeyeceğiz.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 15.654, "end": 17.894, "text": "Terör örgütü buradan defolup gidecek.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 18.234, "end": 19.795, "text": "Çok ağır darbe indirdik.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 19.815, "end": 20.735, "text": "Fare gibi kaçtılar.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 20.755, "end": 27.956, "text": "Hünbik'in güneydoğusunda günlerce süren çatışmaların ardından PKK'yı", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 29.419, "end": 30.368, "text": " Pekal koyun.", "speaker_id": "SPEAKER_01", "flags": []}], "words": [{"start": 2.671, "end": 2.791, "word": "Terör", "segment_idx": 0, "speaker_id": "SPEAKER_01"}, {"start": 2.811, "end": 3.272, "word": "örgütü", "segment_idx": 0, "speaker_id": "SPEAKER_01"}, {"start": 3.432, "end": 3.972, "word": "PKK'nın", "segment_idx": 0, "speaker_id": "SPEAKER_01"}, {"start": 4.012, "end": 4.452, "word": "nefesini", "segment_idx": 0, "speaker_id": "SPEAKER_01"}, {"start": 4.512, "end": 4.832, "word": "kestik.", "segment_idx": 0, "speaker_id": "SPEAKER_01"}, {"start": 5.252, "end": 5.492, "word": "Son", "segment_idx": 1, "speaker_id": "SPEAKER_01"}, {"start": 5.552, "end": 5.892, "word": "kalanı", "segment_idx": 1, "speaker_id": "SPEAKER_01"}, {"start": 5.952, "end": 6.052, "word": "da", "segment_idx": 1, "speaker_id": "SPEAKER_01"}, {"start": 6.072, "end": 6.492, "word": "burada", "segment_idx": 1, "speak