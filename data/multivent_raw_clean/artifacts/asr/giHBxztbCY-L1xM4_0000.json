14376984536648, 0.04388616606593132, 0.07324282824993134, 0.030633529648184776, 0.029485389590263367, -0.038297154009342194, 0.0619795061647892, -0.00047771737445145845, -0.021035751327872276, 0.040636107325553894, -0.002018496859818697, 0.02310258336365223, 0.004200284369289875, 0.02140319161117077, 0.08721420168876648, 0.016535598784685135, -0.1310785859823227, -0.029996085911989212, -0.07927355170249939, -0.03379896283149719, -0.08211411535739899, 0.03427992761135101, 0.019717741757631302, 0.011267184279859066, 0.002356951357796788, 0.05281797796487808, 0.01945117674767971, -0.061752595007419586, 0.020505765452980995, 0.053496260195970535, 0.04592204466462135, 0.025283588096499443, -0.010827922262251377, -0.011448337696492672, 0.032163865864276886, -0.08640257269144058, -0.008683259598910809, 0.009077800437808037, 0.03375093266367912, 0.0014015811029821634, 0.023202642798423767, 0.033062830567359924, -0.026285311207175255, 0.01869312860071659, 0.03338839113712311, 0.056107327342033386, 0.042195796966552734], "n_turns": 76}], "transcript": {"timestamp_resolution": "word", "segments": [{"start": 1.838, "end": 15.284, "text": " Воскресенье Твое, Христе слаще!", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 18.125, "end": 39.45, "text": " Ангели поют на небесе, и нас на земли спадут.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 48.943, "end": 55.015, "text": " Субтитры подогнал «Симон»", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 65.493, "end": 84.018, "text": " Воскресенье Твое, Христе, спаси ангелы.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 84.078, "end": 100.749, "text": " И поют на небесе, и в нас на земли спадут.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 108.06, "end": 117.346, "text": " И мы с сердцем тебе славим.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 121.818, "end": 140.307, "text": " Воскресенье Твое, Христе Спасе, Ангелик Твоё,", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 142.288, "end": 150.131, "text": " Субтитры создавал DimaTorzok", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 159.941, "end": 174.268, "text": " Тебе славу истинное, Семье Твое вместе с нами.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 174.388, "end": 183.832, "text": "Ангели поют, Ноги везли нас на земли порой.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 190.52, "end": 213.179, "text": " Воскресенье Твое Христе спасет, Ангели поют на небесе, И нас на земли сподобит.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 213.701, "end": 220.53, "text": " Чистым сердцем Тебе славить.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 220.57, "end": 232.265, "text": "Слава Святей Единосущной, Заводворящей нераздельной Троице, Всегда, ныне и присно, и вовеки веков.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 233.178, "end": 244.847, "text": " Христос воскресе из мертвых, Смертью смерть поправ, И сущим во гробе живут дорога.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 244.867, "end": 254.334, "text": "Христос воскресе из мертвых, Смертью смерть поправ, И сущим во гробе живут дорога.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 254.354, "end": 259.738, "text": "Христос воскресе из мертвых, Смертью смерть поправ,", "speaker_id": null, "flags": []}, {"start": 260.112, "end": 268.84, "text": " Христос воскресе из мертвых, Смертью смех поправ!", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 270.222, "end": 277.148, "text": "Христос воскресе из мертвых, Смертью смех поправ!", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 277.168, "end": 279.871, "text": "Христос воскресе из мертвых,", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 283.76, "end": 291.293, "text": " Смерть и смерть поправ, И сущим добежьего дарова.", "speaker_id": "SPEAKER_01", "flags": []}], "words": [{"start": 1.838, "end": 7.26, "word": "Воскресенье", "segment_idx": 0, "speaker_id": "SPEAKER_01"}, {"start": 7.28, "end": 9.741, "word": "Твое,", "se