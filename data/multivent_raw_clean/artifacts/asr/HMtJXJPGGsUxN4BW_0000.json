urns": 17}], "transcript": {"timestamp_resolution": "word", "segments": [{"start": 4.823, "end": 6.265, "text": " 박수선 씨?", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 6.305, "end": 7.586, "text": "저희는 진짜 너무 떨리잖아요.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 7.727, "end": 14.836, "text": "근데 이분은 은석열과의 악연으로 보면 이 사람은 직접적 악연이거든요.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 14.956, "end": 15.136, "text": "맞아요.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 15.917, "end": 16.357, "text": "맞아요.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 16.458, "end": 17.138, "text": "직접적 악연.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 17.178, "end": 22.565, "text": "근데 저희와는 또 소외가 다를 겁니다.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 22.665, "end": 23.366, "text": "저희가 백수되는 날.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 23.466, "end": 23.867, "text": "사적 복수가 시작되는 날.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 23.887, "end": 24.027, "text": "사적 복수.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 29.224, "end": 30.485, "text": " 아니 근데 의원님도 긴장되거나 그런 건 전혀 없으세요?", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 30.805, "end": 31.386, "text": "없죠.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 31.766, "end": 32.207, "text": "아 그래요?", "speaker_id": null, "flags": []}, {"start": 32.307, "end": 37.731, "text": "저는 막 입이 말라가지고 긴장할 만한 가치가 없는 걸 가지고 지금 제안을 하는 거라서 그래요.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 37.751, "end": 44.057, "text": "가고 싶어도 못 가지고 갈 수도 없고 결혼을 하루 앞둔 신인규 신랑.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 44.077, "end": 48.761, "text": "박진영 특정사령관 보석을 허가했다.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 49.261, "end": 51.483, "text": "오전 중에 석방.", "speaker_id": "SPEAKER_00", "flags": []}], "words": [{"start": 4.823, "end": 6.205, "word": "박수선", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 6.225, "end": 6.265, "word": "씨?", "segment_idx": 0, "speaker