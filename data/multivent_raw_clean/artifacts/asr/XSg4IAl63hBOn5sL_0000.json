74184, 0.1005639061331749, 0.05850093439221382, 0.07057517766952515, -0.015784094110131264, -0.01972789503633976, -0.058306097984313965, 0.1178227961063385, 0.02887171320617199, -0.06816590577363968, 0.05742136761546135, 0.02868429385125637, 0.005919310264289379, -0.08135689049959183, 0.02702748030424118, -0.035876739770174026, 0.005080185830593109, -0.0077910153195261955, 0.059936851263046265, -0.03289315104484558], "n_turns": 5}], "transcript": {"timestamp_resolution": "word", "segments": [{"start": 0.203, "end": 17.898, "text": " ہر زلاء اور ہر پاتے دے درے درے زائے دیر مسلح اپنات پلیس پا جرگت ہوائے کی تا دھوڑا تا پھلوے زائے خلق رہ دے تا بدہ پختن ملی داکھ کر پناہ ماں یا دیر مسلح ہر خلق بھی", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 20.385, "end": 42.37, "text": " خواب آرہ خلق ہوئی کہ کدھا یختجاج ضرورت کے دا مور پر پور کام بھائیو خدا بخواب آخاوی ور سرا کدھا جلسے ضرورت ہو کدھا یوزائی دپانکاویو درشاہ دپاپوزو ونہ دے منیل اختر جوک شیئے خدا ہی مکہ خود تنن خلق ناظری دی سبادہ جا دا پور نا پور تکاویو سوائم منیل اختر کسوک دلا جواز", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 42.647, "end": 66.202, "text": " کہ قانون بیر آئینی طریقہ پر بیر اسلامی اور پر بیر پخلیم علی طریقہ تمہاں یوٹن بھی یلیدہ کردہ ورننہوزیت پورتا واپس لے دی رہا ہوئی۔ تا چھوٹ میں یوٹن ورننہوزیت بھی یلیدہ کردہ پر لے دی اور چاہاں یوٹن لے دی اگر اس پر جھوڑنے ہوئی۔ دوستونا تاکہ دی سیکیورٹی مسئلہ آئے مدائم شیر، مونڈا ڈرگا تا تجویز پیش کرو۔", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 66.602, "end": 86.144, "text": " جس طرح جو 45 کروڑوں، جو 35 کروڑوں ریجسٹر پر تعلیٰ جا رہا ہے، جو ہر سیلے مسلطہ پر، اور جو ہر پارٹیل مسلطہ پر، اور جو ہر پروفیشن مسلطہ پر دا، دا جلد پر شریکہ، دا افغانستان پہلے سانی وقت دا رکھ رکھے، جو پا افغانستان کے دل انجیون تعلیم تھا۔", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 86.144, "end": 110.634, "text": " سواسائی ورکی، دوار سوکی، اجازت ورکی، سلام پا افغانستان کے تلقیت زمون پردیقہ و لسونوں ہم دلوئی اثر داری لہذا تیرہ قومتوں اور نومی خالقوں شریکہ جرگا ورکوئی اور شریک حلزہ لے افغانستان راو بچی چاہتے ہوں کہ یہ کشالوں کا بچ چی لہذا ہر کشالہ دیرہ سیرہ کی تلقیت اور پھر بسیگی", "speaker_id": "SPEAKER_00", "flags": []}], "words": [{"start": 0.203, "end": 0.343, "word": "ہر", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 0.423, "end": 2.205, "word": "زلاء", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 2.285, "end": 2.545, "word": "اور", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 2.625, "end": 3.606, "word": "ہر", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 3.686, "end": 4.407, "word": "پاتے", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 4.447, "end": 4.587, "word": "دے", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 5.047, "end": 5.327, "word": "درے", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 5.407, "end": 5.588, "word": "درے", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 5.668, "end": 5.948, "word": "زائے", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 6.028, "end": 6.268, "word": "دیر", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 6.328, "end": 7.049, "word": "مسلح", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 7.149, "end": 7.489, "word": "اپنات", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 7.849, "end": 8.31, "word": "پلیس", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 8.37, "end": 8.53, "word": "پا", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 8.59, "end": 8.89, "word": "جرگت", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 8.95, "end": 9.291, "word": "ہوائے", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 9.371, "end": 9.551, "word": "کی", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 9.891, "end": 10.091, "word": "تا", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 10.231, "end": 10.492, "word": "دھوڑا", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 10.552, "end": 10.652, "word": "تا", "segment_idx