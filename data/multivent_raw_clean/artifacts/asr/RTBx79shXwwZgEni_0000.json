34.061, "end": 235.382, "text": "5층을 집중할 수 있는 선행기다.", "speaker_id": "SPEAKER_02", "flags": []}, {"start": 290.639, "end": 292.183, "text": " 1분 전 스피드 에프코아 에프파이베리", "speaker_id": "SPEAKER_00", "flags": []}], "words": [{"start": 33.619, "end": 34.388, "word": "맞습니다.", "segment_idx": 0, "speaker_id": null}, {"start": 183.764, "end": 187.526, "word": "여러분,", "segment_idx": 1, "speaker_id": "SPEAKER_01"}, {"start": 187.546, "end": 198.453, "word": "KF-21이", "segment_idx": 1, "speaker_id": "SPEAKER_01"}, {"start": 198.633, "end": 199.013, "word": "활주로", "segment_idx": 1, "speaker_id": "SPEAKER_02"}, {"start": 199.193, "end": 199.714, "word": "좌측에서", "segment_idx": 1, "speaker_id": "SPEAKER_02"}, {"start": 200.014, "end": 200.134, "word": "롤", "segment_idx": 1, "speaker_id": "SPEAKER_02"}, {"start": 200.214, "end": 200.634, "word": "기동과", "segment_idx": 1, "speaker_id": "SPEAKER_02"}, {"start": 200.854, "end": 201.575, "word": "배면비행을", "segment_idx": 1, "speaker_id": "SPEAKER_02"}, {"start": 201.675, "end": 201.855, "word": "위해", "segment_idx": 1, "speaker_id": "SPEAKER_02"}, {"start": 202.075, "end": 203.796, "word": "진입하겠습니다.", "segment_idx": 1, "speaker_id": "SPEAKER_02"}, {"start": 206.158, "end": 206.478, "word": "이어서", "segment_idx": 2, "speaker_id": "SPEAKER_02"}, {"start": 206.498, "end": 207.238, "word": "배면비행은", "segment_idx": 2, "speaker_id": "SPEAKER_02"}, {"start": 207.679, "end": 208.379, "word": "고난인별", "segment_idx": 2, "speaker_id": "SPEAKER_02"}, {"start": 208.419, "end": 209.119, "word": "비행에", "segment_idx": 2, "speaker_id": "SPEAKER_02"}, {"start": 209.139, "end": 209.28, "word": "해당하니", "segment_idx": 2, "speaker_id": "SPEAKER_02"}, {"start": 209.32, "end": 209.92, "word": "주의하시기", "segment_idx": 2, "speaker_id": "SPEAKER_02"}, {"start": 209.94, "end": 210.04, "word": "바랍니다.", "segment_idx": 2, "speaker_id": null}, {"start": 224.979, "end": 225.16, "word": "고맙습니다", "segment_idx": 3, "speaker_id": null}, {"start": 229.938, "end": 230.058, "word": "첫째",