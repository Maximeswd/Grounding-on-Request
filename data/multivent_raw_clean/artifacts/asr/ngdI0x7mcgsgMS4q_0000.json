73, 0.07253872603178024, 0.025826819241046906, 0.04944329708814621, 0.04407378286123276, 0.0926874428987503, 0.15714912116527557, -0.08577048033475876, 0.035049643367528915, -0.01629040762782097, 0.05028773844242096, 0.22608119249343872, -0.1460857391357422, -0.0580170564353466, 0.11611829698085785, 0.1756381094455719, -0.12607939541339874], "n_turns": 1}], "transcript": {"timestamp_resolution": "segment", "segments": [{"start": 0.031, "end": 25.242, "text": " مک پا دی سیمه که دیر باویقار جوان کرده افغان ملت پا دی خطه که پا دیر و ملتونو باندی حکومتونو کردی تاسی وز هم پا اقتصادی لحاظ دیر زیاد بدایی هست یوازی زی تاستو وهم دی افغانستان کانی زیرمه دی افغانستان زراعتی زیرمه دی افغانستان دی بریخنافه برخه که چکم زرفیت لرو دا هر چه که کنش تکه یوازی دی ترانزیت فیس", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 25.242, "end": 45.29, "text": " چی مک تاسی وکا ولی سو چی مرکزی آسیا ولو جنبی آسیا سرا وسل کو دیگی ترانزیت فیس یوازی دی موتارونو یوازی دی انجنری دی انتقالاتو دی بریکنا انتقالات دی گاز و انتقالات دا طول چی محاسبه کو و دی دیگی تا مک تاسی تا راسی دی افغانستان هر وگرده پا دیگی میلون نرده یو شای پا سراحت در تا وایم", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 45.29, "end": 64.325, "text": " اسلامی امارات پر طول امانه بانی پر دی تمرکست کرده شو پر افغانستان که چکمه منابی دی دا باید دی هر افغان کور تا ورسیگی او پر دی بان دی باویقارا با عیزت جواند ولری ننجه تاسی عرب امارات گوری تاسی چه قطر گوری نور هوادونه گوری دی هغوی زخایر", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 64.477, "end": 91.983, "text": " دی مگ دی زخایر پا پرتلاو بانده هیچ دی دا طول زخایر چه تر ننا پوری مگ پا دی بانده وحل خورده دی شرقا و غرب دی مگ پا کور رانده نواته مگ وحلیو لدی وروستا با دی داغی تاسو طولو پا حیمت بانده دا زخایر دا امکانات دی افغان حیزت دی ساتلو لپارا کاریگی دا ملت با دی نورو مرستا خستون که نه بلکی پا نورو مسلمانو ملتونو بانده که بدا ورز رازی مگ بلدی", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 92.81, "end": 107.71, "text": " هاگوی تم رسته رسو، او ز باور لرم، ز پخپل رب و پخپل خدای باور لرم، دا رب غیرتی دا، هاگا ملتون چی غیرت لری، پا دین بانه ننگ کلی، غیرت کلی، باور و لری، چی مک تاسی با تربل هرچا،", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 108.335, "end": 125.294, "text": " باویقارا بایزت تا ساتی. دگه تو رشپا چو وست پا دگه امکانات رو راناسه وی. زی تاستا باور درکوم چو دی مک تاسی راتلونی که با دی سیوی پا پر تلا. دی نره دی هر ملت پا پر ترا بانده. تر تولو باویقارا بایزت منده ای. او دگه هدف تا رسیدو دی پارا با گرده کار.", "speaker_id": "SPEAKER_00", "flags": []}], "words": []}, "qc_flags": [], "chunk_id": "ngdI0x7mcgsgMS4q_0000", "video_id": "ngdI0x7mcgsgMS4q", "chunk_index": 0}