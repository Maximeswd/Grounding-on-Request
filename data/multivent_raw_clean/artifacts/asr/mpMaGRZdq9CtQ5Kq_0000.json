48548031598329544, -0.02765137515962124, 0.03236602991819382, -0.06502164155244827, 0.0197152029722929, 0.04066745564341545, -0.05439332500100136, 0.030272437259554863, -0.006365295499563217, 0.010799960233271122, -0.06171164661645889, -0.013886429369449615, 0.0077331229113042355, -0.0470372773706913, -0.12744569778442383, -0.07920420169830322, 0.025373389944434166, -0.09597866237163544, -0.040232788771390915, 0.04154481738805771, 0.16294324398040771, -0.012260984629392624, 0.1155913919210434, 0.11816486716270447, -0.03824535384774208, 0.06193959340453148, -0.08454585820436478, -0.03839500993490219, -0.029268799349665642, 0.03548493608832359, -0.04741901904344559, -0.016072386875748634, -0.07938376069068909, 0.024080466479063034, 0.0024947868660092354, -8.854231418808922e-05, -0.07931997627019882, 0.010564987547695637, 0.03601077198982239, -0.045598648488521576, -0.009372702799737453, 0.014754831790924072, 0.06302732974290848, 0.019825443625450134], "n_turns": 13}], "transcript": {"timestamp_resolution": "word", "segments": [{"start": 1.897, "end": 4.699, "text": " Никольская улица.", "speaker_id": "SPEAKER_01", "flags": []}, {"start": 4.759, "end": 10.364, "text": "В этом году снега в Москве выпало невиданное количество.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 10.404, "end": 20.993, "text": "И вот мы пошли погулять в центр. Сегодня ещё и китайский Новый год продолжается.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 21.013, "end": 21.614, "text": "А зачем?", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 21.654, "end": 22.394, "text": "Классно!", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 22.434, "end": 23.976, "text": "Зима!", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 24.016, "end": 24.997, "text": "Всё завалено!", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 28.907, "end": 35.234, "text": " Такие вот картинки из-за сугробов.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 35.274, "end": 38.057, "text": "В переулках тоже всё.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 38.137, "end": 46.887, "text": "Доверху Саша возле серой кучки.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 46.927, "end": 49.39, "text": "Ржу, что говорю, как это в деревне.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 49.875, "end": 51.236, "text": " Ну а куда это вывозить?", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 51.277, "end": 53.619, "text": "Чтобы вывозить, надо перекрыть улицу.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 53.679, "end": 55.12, "text": "А тут столько народу гуляет.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 55.14, "end": 58.784, "text": "Когда надо сделать, все перекрывают.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 58.844, "end": 59.925, "text": "Это да.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 59.965, "end": 62.288, "text": "Сергей Семенович у нас умеет.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 62.528, "end": 66.552, "text": "Смотрите, как красивенько.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 68.437, "end": 78.207, "text": " Я, честно говоря, рада, что убрали с Никольской вот эти вот, висели, наверное, лет 10, гирляндочки, такие, ну, висюльки белые.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 78.247, "end": 83.933, "text": "Они вроде сперва были в диковинку, а потом, честно говоря, так всем надоели и запылились как-то.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 84.293, "end": 85.614, "text": " И зимой, и летом веселье.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 85.634, "end": 89.598, "text": "Сейчас вот повесили такие фонарики, но сейчас светло.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 89.638, "end": 95.042, "text": "А вечером, я думаю, здорово будет все это играть.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 95.102, "end": 100.886, "text": "Если еще и снежок падает, то вообще Рождество и такой Merry Christmas.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 100.927, "end": 103.729, "text": "А мы на самом деле движемся в сторону Манежной.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 103.749, "end": 109.353, "text": "Там обещали нам китайский Новый год до 1 марта.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 109.373, "end": 111.575, "text": "Такие скамейки в снегу.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 114.524, "end": 118.688, "text": " Октябренок Саша.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 118.748, "end": 120.93, "text": "Еще зайдем в магазин Аленка.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 121.05, "end": 124.534, "text": "С шоколадными конфетками.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 124.554, "end": 127.216, "text": "Народ так гуськом тянется друг за другом.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 127.256, "end": 129.278, "text": "Где-то ленты перегорожены.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 129.318, "end": 131.4, "text": "Типа не заходить, не садиться.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 131.5, "end": 135.003, "text": "Это вот у нас такая красота.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 135.043, "end": 139.047, "text": "На месте первой книгопечатной типографии.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 139.968, "end": 164.927, "text": " вот на плитке вот когда вот так вот так вот то скользко осторожно саша сюда не наступай поехали домой поехали но сейчас выйдем на манежку и поедем домой солнце ушло мы просто ехали была такая классная солнечная погода а сейчас солнышко уже ушло но", "speaker_id": "SPEAKER_00", "flags": []}], "words": [{"start": 1.897, "end": 2.478, "word": "Никольская", "segment_idx": 0, "speaker_id": "SPEAKER_01"}, {"start": 2.538, "end": 4.699, "word": "улица.", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 4.759, "end": 4.779, "word": "В", "segment_idx": 1, "speaker_id": "SPEAKER_00"