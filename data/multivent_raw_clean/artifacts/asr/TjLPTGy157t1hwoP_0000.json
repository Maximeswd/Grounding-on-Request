l, "flags": []}, {"start": 59.454, "end": 60.554, "text": "Fy faen, hvem som kommer?", "speaker_id": null, "flags": []}, {"start": 60.574, "end": 61.875, "text": "Det er svært!", "speaker_id": null, "flags": []}, {"start": 61.895, "end": 63.837, "text": "Fy faen!", "speaker_id": null, "flags": []}, {"start": 63.857, "end": 65.118, "text": "Hva gjør vi?", "speaker_id": null, "flags": []}, {"start": 74.651, "end": 78.007, "text": " Teksting av Nicolai Winther", "speaker_id": null, "flags": []}, {"start": 121.04, "end": 128.686, "text": " Takk for at du så med.", "speaker_id": null, "flags": []}, {"start": 156.016, "end": 162.74, "text": " Eg har fått beskjed å prøve å sparke det frå badstigen.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 162.76, "end": 164.161, "text": "Det går ikkje.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 164.241, "end": 169.445, "text": "Nødroret funkar heller ikkje.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 169.465, "end": 170.105, "text": "Skysst vatten, vet du.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 170.125, "end": 173.188, "text": "Det er framme, vet du ikkje.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 173.328, "end": 175.869, "text": "Ja, men det her.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 175.889, "end": 177.35, "text": "Blir tida er der.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 177.39, "end": 179.432, "text": "Få på nå.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 179.452, "end": 181.133, "text": "Så det skal berre dokumentert.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 183.45, "end": 190.478, "text": " Vi ser fram til å fikse termalynet.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 190.518, "end": 196.444, "text": "Så er det noen spekagre som lurer seg ut i stedet.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 196.484, "end": 197.165, "text": "Det gikk ikke.", "speaker_id": "SPEAKER_00", "flags": []}], "words": [{"st