flags": []}, {"start": 4.056, "end": 6.759, "text": "The Songhua River here freezes completely.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 6.919, "end": 9.782, "text": "Workers cut large blocks of ice from the frozen river.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 9.902, "end": 17.271, "text": "This ice is highly valuable and is used to create magnificent buildings and beautiful sculptures for the Harbin Ice Festival.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 17.471, "end": 20.198, "text": " Cutting ice is a very difficult and dangerous task.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 20.378, "end": 22.864, "text": "If it takes too long, the ice can freeze again.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 23.065, "end": 29.179, "text": "Sometimes the ice breaks, causing workers to fall into the freezing water, which is extremely hazardous.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 29.42, "end": 33.028, "text": "Every year this festival takes place from January to February.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 33.249, "end": 35.174, "text": "Have you ever attended an ice festival?", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 35.414, "end": 37.038, "text": "If yes, how was your experience?", "speaker_id": "SPEAKER_00", "flags": []}], "words": [{"start": 0.151, "end": 0.231, "word": "In", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 0.271, "end": 0.351, "word": "the", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 0.411, "end": 0.752, "word": "city", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 0.892, "end": 0.972, "word": "of", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 1.052, "end": 1.533, "word": "Harbin,", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 1.753, "end": 2.234, "word": "China,", "segment_idx": 0, "speaker_id": "SPEAKER_00"}, {"start": 2.414, "end": 2.814, "word": "winters", "segment_idx": 0, "speaker_i