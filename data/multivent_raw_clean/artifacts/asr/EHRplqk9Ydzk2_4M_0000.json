 -0.034452978521585464, 0.045634135603904724, -0.17196683585643768, 0.057086359709501266, 0.0646018534898758, -0.1535073220729828], "n_turns": 3}], "transcript": {"timestamp_resolution": "segment", "segments": [{"start": 0.031, "end": 23.082, "text": " دو چیان دی، یو خود دا زمونگ مهاجرین و دا اسلامی و گواندی طوب و انسانی حقوق دی، دا باید هست سوک باید دا شولاندی و نکی، دا زمونگ گواندیان هم با بینالبرالی وصولو لمخی، اسلامی وصولو لمخی و گواندی طوب لمخی دی مکلف دی،", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 23.082, "end": 40.497, "text": " باید ماجرینو تا ضربو نرسید، دو دی سامان دی، وسائل دی، دو دی حال تا پاتکیدو دی، طول باید وساطل شید. یک خواهش ما از برادرانو پاکستانی همی است که", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 41.257, "end": 65.219, "text": " ملت پاکستان، ملت افغانستان با هم برادر هستند، ما همیشه با دیگر تعلقات تاریخی داریم، باید این تعلقات تاریخی در نظر گرفته شود، ما یک روزه نیست، همیشه با هم دیگر همسایه هستیم، ما در اون طرف میریم، اونا در این طرف می آیم، این تعلقات برادری ما، تعلقات اسلامی ما، همسایگی ما باید محفوظ شود،", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 65.219, "end": 86.87, "text": " دایی راستا خواهش ما از علما، از کروهای سیاسی، سیاسیون، از مشران خومی، از همه ای است که دایی راستا اونا هم کردار خود عدا کنند، نباید یک همسایگی برادری تاریخی ما و شما باید صدمه نبینند، دایی راستا باید اونا متوجی باشند،", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 86.87, "end": 109.448, "text": " با یقینا دی مسائل بعض ویدیوهای که در مطبوعات دی چیزا بر آمده است گروه هر کس دیدن دی جا دی طرف طبعا یک اثرات منفی میکنه از این خاطر باید دی بارا و نامتواجی باشد اسلامی امارت پدی اپنا مسلم دی انشانلا اگه ورون خواهند دی چی مهاجرین دی دلتا با افغانستان که حس و سیدو زای نلاری کور نلاری اگوی تا با انشانلا مونگ", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 109.448, "end": 129.817, "text": " پا اول قدم که خوا البته زمون مسئولیت دا دی دوی پا محترمانا شکل خپل ولایت و خپل کلی تا باید انتقال شید دگه لپارا مون تول ترتیبات نیولی دی دل تا انشالله سابت و راجستر مسائل دی یه واری مون تا ثابت سی دا افغانان دی", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 129.817, "end": 154.218, "text": " دویم قدم که زی منگ ترانسپورتیشن دی ترانسپورتیشن پا بخش که هم منگ مکمل سئولت داراور که دی دی اسلامی وردو سمر وسائل دی نقلی وسائل دی تول وز دلتا حاضر دی ترسوز منگ دو ورون و خویند و انتقالو که دلتا بودباش مسائل دی اسکان مواقت دی اسکان مواقت لپارا منگ زر خایم بی انشالله ننده پا اومری کم که داراوو", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 154.218, "end": 180.863, "text": " ترسوز من ورون و خوان دی دلتا سمر وقت دلتا پاتیکیگی، وراز دو، تری شبه وراز دلتا ای، تراغ وقت کوری دلتا پاید خوب محترمانه دلتا پاتشی. سیهی چاری دی، نور دوغبو، مسایم دی، هر سه دلتا پراور شویدی. روستا با انشالله من هر یو کورانی سرای و اندازه نقدی کمک هم ورکو، روستا با دوی انتقان کو خپل ولایت و خپل ولسوانی ده.", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 180.863, "end": 208.268, "text": " البته کم باجرین کس وسیدو زای نلاری پایانده که مونگ اگوی سرا انشالله دوسیدو زای پا باب هم هم کاری که او دا فیصل شویدی اگوی تا ببه یو نمرمزک ورکل شی پایانده که سمرز مونگ تاجر ورونه دی اگوی راشی اگوی تا خود دیر سوولت پا نظر که دیول شویدی مونگ بسته و کومیته ده کار نفر جور کنیدی اگوی تا ده دینزه کالو گوری اگوی ده مالیه سخم آفی", "speaker_id": "SPEAKER_00", "flags": []}, {"start": 208.268, "end": 216.048, "text": " او دل تبا با صناتی پارکونو که اغوی تا زکی ورکونو که ایگی دور نور دیر سه اولاد تاجرانو پارا هم تا زکی نیوان سوید", "speaker_id": "SPEAKER_00", "flags": []}], "words": []}, "qc_flags": [], "chunk_id": "EHRplqk9Ydzk2_4M_0000", "video_id": "EHRplqk9Ydzk2_4M", "chunk_index": 0}