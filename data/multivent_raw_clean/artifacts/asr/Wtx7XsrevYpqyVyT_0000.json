": 170.654, "text": " Машына ұзақ сүйесе. Нейсәкін сүйесе.", "speaker_id": "SPEAKER_02", "flags": []}], "words": []}, "qc_flags": ["repetition_loop", "text_in_silent_region"], "chunk_id": "Wtx7XsrevYpqyVyT_0000", "video_id": "Wtx7XsrevYpqyVyT", "chunk_index": 0}